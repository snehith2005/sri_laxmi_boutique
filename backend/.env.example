# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/boutique_db

# JWT settings
SECRET_KEY=change-this-to-a-long-random-secret-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary (get these from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Initial admin account (created automatically on first run)
ADMIN_EMAIL=admin@boutique.com
ADMIN_PASSWORD=admin123

# Frontend URL(s) allowed to call the API (comma-separated, no trailing slash)
# Local: http://localhost:5173   Deployed: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
